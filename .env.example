# Mặc định an toàn, chỉ cho phép truy cập cục bộ. Với ứng dụng khách từ xa, hãy
# đặt tên DNS công khai và đổi RUSTDESK_BIND_ADDRESS thành 0.0.0.0 sau khi cấu
# hình tường lửa trên máy chủ.
RUSTDESK_PUBLIC_HOST=127.0.0.1
RUSTDESK_BIND_ADDRESS=127.0.0.1

# Bản phát hành đa kiến trúc có thể tái tạo từ dự án gốc, đã xác minh ngày 2026-09-29.
RUSTDESK_SERVER_IMAGE=rustdesk/rustdesk-server:1.1.16@sha256:8ecdab65deb7c84652a626380e31d11a8f1fbafd97916d57f95c20628f943c00
RUSTDESK_HUB_IMAGE=local/rustdesk-hub:1.1.16

RUSTDESK_NAT_TEST_PORT=21115
RUSTDESK_RENDEZVOUS_PORT=21116
RUSTDESK_RELAY_PORT=21117
RUSTDESK_WS_RENDEZVOUS_PORT=21118
RUSTDESK_WS_RELAY_PORT=21119

# Tùy chọn: chỉ đặt RUSTDESK_RELAY_ADVERTISED_PORT khi reverse proxy ánh xạ
# relay sang một cổng ngoài khác. Nếu không, giá trị sẽ theo RELAY_PORT.
# RUSTDESK_RELAY_ADVERTISED_PORT=21117

# N ưu tiên đường truyền ngang hàng trực tiếp; Y buộc lưu lượng đi qua relay.
RUSTDESK_ALWAYS_USE_RELAY=N
RUSTDESK_LOG_LEVEL=info

# Giới hạn chất lượng dịch vụ của relay, đơn vị Mbit/s.
RUSTDESK_SINGLE_BANDWIDTH_MBIT=128
RUSTDESK_TOTAL_BANDWIDTH_MBIT=1024
RUSTDESK_LIMIT_SPEED_MBIT=32
